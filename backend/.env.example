# ====================================
# BACKEND ENVIRONMENT VARIABLES
# ====================================

# Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/rental_contract_db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-make-it-very-long-and-random"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV="development"

# Blockchain Configuration
BLOCKCHAIN_NETWORK="mumbai"
CONTRACT_ADDRESS=""
PRIVATE_KEY=""

# Cloud Storage (Optional - will implement later)
CLOUD_STORAGE_BUCKET=""
CLOUD_STORAGE_KEY=""
CLOUD_STORAGE_SECRET=""

# Email Service (Optional - will implement later)
EMAIL_HOST=""
EMAIL_PORT=""
EMAIL_USER=""
EMAIL_PASSWORD=""
