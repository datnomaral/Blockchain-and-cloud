// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LANDLORD  // Chủ nhà
  TENANT    // Người thuê
  ADMIN     // Quản trị viên
}

enum ContractStatus {
  DRAFT         // Bản nháp
  PENDING       // Chờ ký
  SIGNED        // Đã ký
  ACTIVE        // Đang hoạt động
  EXPIRED       // Hết hạn
  TERMINATED    // Đã hủy
}

enum InvoiceStatus {
  UNPAID        // Chưa đóng
  PAID          // Đã đóng
  OVERDUE       // Quá hạn
}

enum PropertyType {
  ROOM          // Phòng trọ
  APARTMENT     // Căn hộ
  HOUSE         // Nhà nguyên căn
  HOTEL         // Khách sạn
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String      @map("password_hash")
  fullName      String      @map("full_name")
  phone         String?
  facebook      String?
  zalo          String?
  walletAddress String?     @unique @map("wallet_address")
  role          Role        @default(TENANT)
  isVerified    Boolean     @default(false) @map("is_verified")
  status        UserStatus  @default(ACTIVE)
  banReason     String?     @map("ban_reason")
  bankAccount   String?     @map("bank_account")  // Số tài khoản ngân hàng
  bankName      String?     @map("bank_name")      // Tên ngân hàng (VD: MB, VCB, TCB)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  ownedProperties   Property[]  @relation("PropertyOwner")
  landlordContracts Contract[]  @relation("LandlordContracts")
  tenantContracts   Contract[]  @relation("TenantContracts")

  @@map("users")
}

model Property {
  id               String        @id @default(uuid())
  ownerId          String        @map("owner_id")
  title            String
  description      String?
  address          String
  city             String
  district         String
  ward             String
  type             PropertyType
  price            Float         // Giá thuê/tháng
  deposit          Float         // Tiền đặt cọc
  area             Float?        // Diện tích (m2)
  bedrooms         Int?
  bathrooms        Int?
  images           String[]      // Array of image URLs
  amenities        String[]      // Tiện nghi
  available        Boolean       @default(true)
  approvalStatus   String        @default("APPROVED") @map("approval_status") // PENDING | APPROVED | REJECTED
  rejectionReason  String?       @map("rejection_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  owner       User          @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contracts   Contract[]

  @@index([ownerId])
  @@index([city, district])
  @@map("properties")
}

model Contract {
  id                String          @id @default(uuid())
  propertyId        String          @map("property_id")
  landlordId        String          @map("landlord_id")
  tenantId          String          @map("tenant_id")
  
  // Contract Details
  startDate         DateTime        @map("start_date")
  endDate           DateTime        @map("end_date")
  monthlyRent       Float           @map("monthly_rent")
  deposit           Float
  paymentDay        Int             @map("payment_day") // Ngày thanh toán hàng tháng
  
  // Contract Content
  terms             String          // Điều khoản hợp đồng
  contractPdf       String?         @map("contract_pdf") // URL to PDF file
  
  // Blockchain Data
  contractHash      String          @unique @map("contract_hash") // SHA-256 hash
  blockchainTxHash  String?         @unique @map("blockchain_tx_hash") // Transaction hash on blockchain
  landlordSignature String?         @map("landlord_signature")
  tenantSignature   String?         @map("tenant_signature")
  signedAt          DateTime?       @map("signed_at")
  terminateReason   String?         @map("terminate_reason")
  terminatedAt      DateTime?       @map("terminated_at")
  
  status            ContractStatus  @default(DRAFT)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  // Relations
  property          Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  landlord          User            @relation("LandlordContracts", fields: [landlordId], references: [id])
  tenant            User            @relation("TenantContracts", fields: [tenantId], references: [id])
  invoices          Invoice[]

  @@index([propertyId])
  @@index([landlordId])
  @@index([tenantId])
  @@index([contractHash])
  @@map("contracts")
}

model BlockchainTransaction {
  id              String    @id @default(uuid())
  txHash          String    @unique @map("tx_hash")
  contractHash    String    @map("contract_hash")
  fromAddress     String    @map("from_address")
  toAddress       String    @map("to_address")
  blockNumber     Int?      @map("block_number")
  gasUsed         String?   @map("gas_used")
  status          String    @default("pending") // pending, confirmed, failed
  createdAt       DateTime  @default(now()) @map("created_at")
  confirmedAt     DateTime? @map("confirmed_at")

  @@index([txHash])
  @@index([contractHash])
  @@map("blockchain_transactions")
}

model Invoice {
  id          String        @id @default(uuid())
  contractId  String        @map("contract_id")
  
  amount      Float         // Số tiền cần đóng
  description String?       // Mô tả (VD: Tiền phòng tháng 5 + điện nước)
  month       Int           // Tháng thu tiền
  year        Int           // Năm thu tiền
  dueDate     DateTime      @map("due_date") // Hạn chót đóng tiền
  
  status      InvoiceStatus @default(UNPAID)
  paidAt      DateTime?     @map("paid_at") // Ngày thực nhận tiền
  
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  contract    Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([month, year])
  @@map("invoices")
}
